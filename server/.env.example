# Server Port (Render sets process.env.PORT automatically, 5000 is default fallback)
PORT=5000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/placement_portal?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_username:your_password@cluster0.xxxx.mongodb.net/placement_portal?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL for CORS configuration (Your Vercel deployment URL)
# Example: https://placementportal.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app
